# ---------------------------------------------------------------------------
# Database (PostgreSQL 14+ — local Docker, Supabase, Neon, Railway…)
# ---------------------------------------------------------------------------
# Pooled connection string used by the app at runtime.
#   Local:    postgresql://postgres:postgres@localhost:5432/apple_score
#   Supabase: the "Transaction pooler" URI (port 6543) with ?pgbouncer=true&connection_limit=1
#   Neon:     the pooled endpoint (host contains "-pooler")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apple_score"

# Direct (non-pooled) connection used by `prisma migrate`. Same as above for local.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apple_score"

# Optional: a separate database for `npm run test:integration` and the E2E suite.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apple_score_test"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth v5
# ---------------------------------------------------------------------------
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical URL of the deployment. Optional on Vercel (inferred automatically),
# required for other hosts and useful for local dev.
AUTH_URL="http://localhost:3000"

# Set to true when running behind a reverse proxy (Vercel sets this for you).
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin, used for metadata, share cards and the sitemap.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeding: set to "true" to also create the demo accounts (never in production).
# SEED_DEMO_USERS="true"
# SEED_DEMO_PASSWORD="applescore123"
