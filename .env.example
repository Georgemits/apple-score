# ---------------------------------------------------------------------------
# Database (PostgreSQL — Supabase or Neon)
# ---------------------------------------------------------------------------
# Pooled connection string used by the app at runtime.
# Supabase: use the "Transaction pooler" URI (port 6543) and append ?pgbouncer=true
# Neon:     use the pooled endpoint (host contains "-pooler")
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection string used by `prisma migrate` / `prisma db push`.
# Supabase: "Direct connection" URI (port 5432).  Neon: the non-pooled endpoint.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth v5
# ---------------------------------------------------------------------------
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical URL of the deployment. Optional on Vercel (inferred automatically),
# required for other hosts and useful for local dev.
AUTH_URL="http://localhost:3000"

# Set to true when running behind a reverse proxy (Vercel sets this for you).
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build shareable public profile links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
